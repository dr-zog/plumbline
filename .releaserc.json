{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\n> Auto-generated by [semantic-release](https://semantic-release.gitbook.io/) from Conventional Commits at each release ([ADR 005](docs/adrs/005-automated-releases-semantic-release.md)) — don't hand-edit. The `0.1.0` and `0.2.0` sections below are the hand-authored history from before the switch."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i 's/\"version\": \"[^\"]*\"/\"version\": \"${nextRelease.version}\"/' plugins/plumbline/.claude-plugin/plugin.json",
        "publishCmd": "make dist VERSION=v${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "plugins/plumbline/.claude-plugin/plugin.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [],
        "successComment": false,
        "failComment": false
      }
    ]
  ]
}
